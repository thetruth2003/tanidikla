APP_ENV=production
APP_DEBUG=false
APP_NAME="Tanıdıkla"
APP_URL=https://tanidikla.com
APP_HOST_ALIASES=www.tanidikla.com,tanidikla.com.tr,www.tanidikla.com.tr
GOOGLE_SITE_VERIFICATION=
APP_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
TRUSTED_PROXY_IPS=
REQUEST_MAX_BYTES=1048576

# Lokal geliştirmede OSM kullanılabilir. Ticari production için domain kısıtlı
# MapTiler anahtarıyla URL'yi değiştir; anahtarı kaynak koda yazma.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap katkıcıları
MAP_TILE_MAX_ZOOM=19

# Canlı yayından önce gerçek kişi/tüzel kişi bilgileriyle doldurulması zorunludur.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_CONTROLLER_EMAIL=kvkk@tanidikla.com
LEGAL_CONTROLLER_KEP=
LEGAL_CONTROLLER_PHONE=
LEGAL_EFFECTIVE_DATE=17.08.2026

DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ankara_services
DB_USER=ankara_app
DB_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_PASSWORD

SESSION_COOKIE=ankara_session
SESSION_TTL_DAYS=30
SESSION_IDLE_MINUTES=120
CSRF_COOKIE=ankara_csrf
PRE_AUTH_CSRF_COOKIE=ankara_pre_auth_csrf
ADMIN_SESSION_COOKIE=ankara_admin_session
ADMIN_CSRF_COOKIE=ankara_admin_csrf
ADMIN_PRE_AUTH_CSRF_COOKIE=ankara_admin_pre_csrf
ADMIN_SESSION_HOURS=8
ADMIN_SESSION_IDLE_MINUTES=30
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

UPLOAD_PATH=storage/uploads
UPLOAD_MAX_MB=8
UPLOAD_IMAGE_MAX_DIMENSION=2400
STORAGE_DRIVER=local
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=eu-central-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_PATH_STYLE=true
STORAGE_ORPHAN_MIN_AGE_SECONDS=86400

MAIL_ENABLED=false
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@tanidikla.com
MAIL_FROM_NAME="Tanıdıkla"

CENTRIFUGO_ENABLED=false
CENTRIFUGO_API_URL=http://127.0.0.1:8000/api
CENTRIFUGO_API_KEY=
CENTRIFUGO_CLIENT_URL=ws://127.0.0.1:8000/connection/websocket
CENTRIFUGO_TOKEN_SECRET=
CENTRIFUGO_TOKEN_TTL_SECONDS=300

SMS_ENABLED=false
NETGSM_API_URL=https://api.netgsm.com.tr/sms/rest/v2/send
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=

# Mobil işletim sistemi bildirimi için sağlayıcı kurulana kadar false kalmalıdır.
# Uygulama içi rozet ve realtime bildirimler Centrifugo/polling ile çalışır.
PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=false

# true olduğunda yeni kayıtlar beta davet kodu olmadan tamamlanmaz.
BETA_MODE=false

# Otomatik fotoğraf moderasyonu bağlı değilse manual kullanılır; sahte onay verilmez.
MEDIA_MODERATION_PROVIDER=manual
MEDIA_MODERATION_API_KEY=

# İçerik filtresi ilan, mesaj, profil, kayıt adı ve yorumlara API tarafında uygulanır.
# Virgül/noktalı virgül ile kesin kelime; boşluk içeren ifade; sonuna * koyarak kök eklenebilir.
CONTENT_POLICY_ENABLED=true
CONTENT_POLICY_EXTRA_BLOCKED=
